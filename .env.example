# mcp-scan environment variables
# Copy to .env and fill in your values

# GitHub token for supply-chain trust scoring (optional)
# Used by the supply-chain scanner when it calls the GitHub API.
# Scopes needed: public_repo (read-only)
# Without it, trust scoring falls back to npm metadata only.
GITHUB_TOKEN=

# ugig.net API key for --submit (optional)
# Get one at: https://ugig.net
# Also usable via the --ugig-key flag.
UGIG_API_KEY=
