                    },
                    "remote": {
                      "type": "string",
                      "description": "Remote name",
                      "default": "origin"
                    },
                    "branch": {
                      "type": "string",
                      "description": "Branch name"
                    }
                  },
                  "required": [
                    "type",
                    "branch"
                  ]
                }
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "actions"
        ]
